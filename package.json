{
  "name": "invite-exchange",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ui": "node scripts/ensure-ui.mjs",
    "dev": "npm run ui && vite",
    "build": "npm run ui && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply invite-exchange --local",
    "db:migrate:remote": "wrangler d1 migrations apply invite-exchange --remote",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test": "bash scripts/test-api.sh",
    "lint": "oxlint"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "hono": "^4.13.22",
    "lucide-react": "^1.81.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
