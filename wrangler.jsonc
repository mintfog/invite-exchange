{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invite-exchange",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "exchange.fshark.cloud", "custom_domain": true }],
  "workers_dev": false,
  "triggers": { "crons": ["0 19 * * *", "*/10 * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invite-exchange",
      "database_id": "5ed14614-5fbb-4aae-bd96-8cbedface41e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // LinuxDO 信任等级下限：低于这个等级的账号只能看，不能领码（0 = 不限制）
    "MIN_TRUST_LEVEL": "1",
    // 每人 24 小时内最多领几个码（不同产品各算一个）
    "MAX_CLAIMS_PER_DAY": "5",
    // 每人 24 小时内最多分享几个码
    "MAX_SHARES_PER_DAY": "30",
    "LINUXDO_BASE": "https://connect.linux.do",
    // 管理员的 LinuxDO 用户名，逗号分隔
    "ADMIN_USERNAMES": "StarFox",
    "LDC_BASE": "https://credit.linux.do"
  }
  // 机密不要写在这里，用 wrangler secret put：
  //   LINUXDO_CLIENT_ID, LINUXDO_CLIENT_SECRET
  //   LDC_CLIENT_ID, LDC_CLIENT_SECRET（LINUX DO Credit 商户凭证，不设就不发 LDC）
}
