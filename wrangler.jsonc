{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linuxdo-invite-relay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "invite.gosniffy.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["0 19 * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invite-exchange",
      "database_id": "396c6e5c-ce1a-45a7-bfad-2cdff137d94f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // LinuxDO 信任等级下限：低于这个等级的账号只能看，不能领码（0 = 不限制）
    "MIN_TRUST_LEVEL": "1",
    // 每人 24 小时内最多领几个码（不同产品各算一个）
    "MAX_CLAIMS_PER_DAY": "5",
    // 每人 24 小时内最多分享几个码
    "MAX_SHARES_PER_DAY": "30",
    "LINUXDO_BASE": "https://connect.linux.do",
    "DEV_LOGIN": "0"
  }
  // 机密不要写在这里，用 wrangler secret put：
  //   LINUXDO_CLIENT_ID, LINUXDO_CLIENT_SECRET
}
